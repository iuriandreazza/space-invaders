{
  "name": "space-invaders",
  "version": "0.1.0",
  "private": true,
  "description": "A browser tribute to the arcade classic Space Invaders, aimed with a reticle and two lasers, with a global leaderboard.",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "node --watch server/main.ts",
    "dev:web": "vite",
    "build": "pnpm typecheck && vite build && tsc -p tsconfig.server.build.json",
    "start": "node dist-server/server/main.js",
    "moderate": "node server/cli.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "record-golden-runs": "node scripts/record-golden-runs.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
